{
  "name": "slamlab-website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/content.mjs && vite --host 127.0.0.1",
    "build": "node scripts/content.mjs && tsc --noEmit && vite build && node scripts/routes.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "format": "prettier --write src scripts tests package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js index.html",
    "format:check": "prettier --check src scripts tests package.json tsconfig.json vite.config.ts playwright.config.ts eslint.config.js index.html"
  },
  "dependencies": {
    "katex": "0.19.1",
    "marked": "18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/katex": "0.16.7",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
